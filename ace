$tempPath = Join-Path $env:TEMP "raws.ps1"

$script | Set-Content -LiteralPath $tempPath -Encoding UTF8 -ErrorAction Stop

if (-not (Test-Path -LiteralPath $tempPath -PathType Leaf)) {
    throw "File was not written: $tempPath"
}

$file = Get-Item -LiteralPath $tempPath

Write-Host "Successfully written: $tempPath"
Write-Host "Size: $($file.Length) bytes"

$process = Start-Process powershell.exe `
    -ArgumentList "-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "`"$tempPath`"" `
    -WindowStyle Hidden `
